{
  "name": "nightward",
  "private": true,
  "type": "module",
  "description": "Headless checks for Nightward. The game itself has no dependencies; these are for the tools in tools/.",
  "scripts": {
    "build": "python3 src/build.py",
    "smoke": "node tools/smoke.mjs",
    "instances": "node tools/instances.mjs",
    "balance": "node tools/balance.mjs",
    "net": "node tools/net.mjs",
    "roster": "node tools/roster.mjs",
    "scout": "node tools/scout.mjs",
    "fog": "node tools/fog.mjs",
    "turret": "node tools/turret.mjs",
    "select": "node tools/select.mjs",
    "gate": "node tools/gate.mjs",
    "decals": "node tools/decals.mjs",
    "terrain": "node tools/terrain.mjs",
    "lighting": "node tools/lighting.mjs",
    "combat": "node tools/combat.mjs",
    "hud": "node tools/hud.mjs",
    "weather": "node tools/weather.mjs",
    "pace": "node tools/pace.mjs",
    "audio": "node tools/audio.mjs",
    "campaign": "node tools/campaign.mjs",
    "economy": "node tools/economy.mjs",
    "pathing": "node tools/pathing.mjs",
    "roads": "node tools/roads.mjs",
    "text": "node tools/text.mjs",
    "check": "python3 src/build.py && node tools/smoke.mjs && node tools/instances.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
